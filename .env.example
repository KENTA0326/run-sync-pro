# 初回セットアップ: このファイルをコピーして .env を作成してください
#   cp .env.example .env
#
# データベース（PostgreSQL）
# docker-compose の db / backend で参照します
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=runsync_db

# バックエンドの DB 接続は上記から自動で組み立てられます。
# 別の接続先を使う場合のみ DATABASE_URL を設定してください（postgres:// 形式）
# DATABASE_URL=postgres://user:password@db:5432/runsync_db?sslmode=disable&TimeZone=Asia/Tokyo

# 構造化ログ（slog）
# LOG_LEVEL=debug|info|warn|error
# LOG_FORMAT=json|text
# LOG_SOURCE=true でソースファイル行を付与（デバッグ用）
# LOG_LEVEL=info
# LOG_FORMAT=json
# LOG_SOURCE=false

# パスワードリセット
# FRONTEND_BASE_URL=http://localhost:3001
# PASSWORD_RESET_TOKEN_TTL_MINUTES=60
# SMTP 未設定時は API レスポンスに reset_url を含める（ローカル開発用。本番は false 推奨）
# PASSWORD_RESET_DEV_EXPOSE_LINK=true
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=noreply@example.com

# gRPC（任意・学習用 Health サービス。未設定なら gRPC は起動しない）
# GRPC_PORT=9090

# Redis（月別分析キャッシュ。未設定ならキャッシュ無効で従来どおり DB 集計）
# REDIS_URL=redis://redis:6379/0
# ANALYSIS_CACHE_TTL_SEC=300

# 外部 REST API クライアント（internal/httpclient。未設定なら FromEnv は ErrNotConfigured）
# EXTERNAL_API_BASE_URL=https://api.example.com
# EXTERNAL_API_API_KEY=
# EXTERNAL_API_TIMEOUT_SEC=10
# EXTERNAL_API_MAX_RETRIES=3
