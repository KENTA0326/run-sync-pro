# 初回セットアップ: このファイルをコピーして .env を作成してください
#   cp .env.example .env
#
# データベース（PostgreSQL）
# docker-compose の db / backend で参照します
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=runsync_db

# バックエンドの DB 接続は上記から自動で組み立てられます。
# 別の接続先を使う場合のみ DATABASE_URL を設定してください（postgres:// 形式）
# DATABASE_URL=postgres://user:password@db:5432/runsync_db?sslmode=disable&TimeZone=Asia/Tokyo
